rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of a document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check project role
    function getRole(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.roles[request.auth.uid];
    }
    
    function isProjectMember(projectId) {
       return request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
    }

    // USERS collection
    match /users/{userId} {
      // Any authenticated user can create their own user document
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Only the user themselves can read or update their own document
      allow read, update: if isAuthenticated() && isOwner(userId);
      
      // Users cannot be deleted for now
      allow delete: if false;
    }

    // PROJECTS collection
    match /projects/{projectId} {
      // READ:
      // Allow read if the project is public OR if the user is a member of the project
      allow read: if resource.data.isPublic == true || (isAuthenticated() && isProjectMember(projectId));

      // CREATE:
      // A user can create a project if they are authenticated and are setting themselves as the owner.
      allow create: if isAuthenticated() && request.resource.data.roles[request.auth.uid] == 'owner';
      
      // UPDATE:
      // A user can update a project if they are an owner or editor.
      allow update: if isAuthenticated() && (getRole(projectId) == 'owner' || getRole(projectId) == 'editor');
      
      // DELETE:
      // Only the owner can delete a project.
      allow delete: if isAuthenticated() && getRole(projectId) == 'owner';

      // PROMPTS subcollection
      match /prompts/{promptId} {
        // Allow full access (list, get, create, update, delete) if the user is a member of the parent project.
        allow list, get: if isAuthenticated() && isProjectMember(projectId);
        allow create, update, delete: if isAuthenticated() && (getRole(projectId) == 'owner' || getRole(projectId) == 'editor');
      }
    }
    
    // FEEDBACK collection
    match /feedback/{feedbackId} {
       // Anyone can submit feedback, but they must be logged in.
       allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
       
       // Public can read feedback for testimonials, but cannot list all feedback.
       allow get: if true;
       allow list, update, delete: if false;
    }

    // SUBSCRIPTIONS collection
    match /subscriptions/{userId} {
      // Users can only read their own subscription document.
      allow get: if isAuthenticated() && isOwner(userId);
      
      // Subscriptions are managed by backend webhooks, so client cannot write.
      allow list, create, update, delete: if false;
    }
  }
}
