rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Projects Collection
    match /projects/{projectId} {
      // READ:
      // - Allow if the project is public.
      // - Allow if the user is a collaborator (has a role).
      allow read: if resource.data.isPublic == true || (isSignedIn() && request.auth.uid in resource.data.roles);

      // CREATE:
      // - Allow if the user is signed in.
      // - The new project must set the creator as the owner.
      // - The project must be private initially.
      allow create: if isSignedIn()
                    && request.resource.data.roles[request.auth.uid] == 'owner'
                    && request.resource.data.isPublic == false;
      
      // UPDATE:
      // - Allow if the user is an owner or editor.
      // - Only owners can change roles or public status.
      function canEdit() {
        return isSignedIn() && resource.data.roles[request.auth.uid] in ['owner', 'editor'];
      }
      function isOwner() {
        return isSignedIn() && resource.data.roles[request.auth.uid] == 'owner';
      }
      allow update: if (canEdit() && !(request.resource.data.isPublic != resource.data.isPublic || request.resource.data.roles != resource.data.roles))
                    || (isOwner());

      // DELETE:
      // - Allow only if the user is the owner.
      allow delete: if isOwner();

      // Prompts Subcollection
      match /prompts/{promptId} {
        // READ:
        // - Allow if the parent project is public.
        // - Allow if the user is a collaborator on the parent project.
        allow read: if get(/databases/$(database)/documents/projects/$(projectId)).data.isPublic == true || (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.roles);

        // WRITE (create, update, delete):
        // - Allow if the user is an owner or editor of the parent project.
        allow write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.roles && get(/databases/$(database)/documents/projects/$(projectId)).data.roles[request.auth.uid] in ['owner', 'editor'];
      }
    }

    // Users Collection
    match /users/{userId} {
        // Anyone can create their own user document.
        allow create: if isUser(userId);
        // Only the user themselves can read or update their own document.
        allow read, update: if isUser(userId);
        // Nobody can delete user documents.
        allow delete: if false;
    }

    // Feedback Collection
    match /feedback/{feedbackId} {
        // Only authenticated users can create feedback.
        allow create: if isSignedIn();
        // Feedback is write-only for clients.
        allow read, update, delete: if false;
    }
  }
}
